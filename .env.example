# Copy this file to a gitignored dotenv file at the repo root. Never commit real values.

# Funding wallet. The same deployer that owns the Arc testnet TRAIDE fleet.
ARC_DEPLOYER_PRIVATE_KEY=

# BIP-39 mnemonic used to derive the three agent wallets deterministically.
# Generate one locally with: python3.11 -m scripts.new_seed
AGENT_SEED_MNEMONIC=

# The Graph Token API bearer JWT.
# Without this the agents refuse to trade on the price signal.
GRAPH_API_KEY=

# Optional: Subgraph Studio gateway key for the decentralized network.
GRAPH_GATEWAY_API_KEY=

# Optional overrides
ARC_RPC_URL=https://rpc.testnet.arc.io
DASHBOARD_PORT=17360
